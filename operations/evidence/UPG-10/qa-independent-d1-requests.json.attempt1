  {
    "statements": [
      {
        "sql": "ALTER TABLE products ADD COLUMN revision INTEGER NOT NULL DEFAULT 0 CHECK(revision>=0);",
        "params": []
      },
      {
        "sql": "ALTER TABLE products ADD COLUMN current_profile_version_id TEXT;",
        "params": []
      },
      {
        "sql": "CREATE UNIQUE INDEX idx_products_workspace_id ON products(workspace_id,id);",
        "params": []
      },
      {
        "sql": "CREATE TABLE product_profile_versions (\n  id TEXT PRIMARY KEY,workspace_id TEXT NOT NULL,product_id TEXT NOT NULL,\n  version_number INTEGER NOT NULL CHECK(version_number>0),schema_version INTEGER NOT NULL CHECK(schema_version=1),\n  profile_json TEXT NOT NULL CHECK(json_valid(profile_json)),profile_sha256 TEXT NOT NULL CHECK(length(profile_sha256)=64),\n  source TEXT NOT NULL CHECK(source='user_confirmed'),created_at TEXT NOT NULL,created_by_user_id TEXT NOT NULL,\n  FOREIGN KEY(workspace_id,product_id) REFERENCES products(workspace_id,id) ON DELETE CASCADE,\n  UNIQUE(product_id,version_number),UNIQUE(workspace_id,product_id,id)\n);",
        "params": []
      },
      {
        "sql": "CREATE INDEX idx_profile_history ON product_profile_versions(workspace_id,product_id,version_number DESC);",
        "params": []
      },
      {
        "sql": "CREATE TABLE product_mutation_requests (\n  workspace_id TEXT NOT NULL,product_id TEXT NOT NULL,request_id TEXT NOT NULL,\n  action TEXT NOT NULL CHECK(action IN ('profile','reference','lifecycle')),fingerprint TEXT NOT NULL CHECK(length(fingerprint)=64),\n  result_revision INTEGER NOT NULL,result_profile_version_id TEXT,result_reference_version_id TEXT,\n  result_status TEXT NOT NULL CHECK(result_status IN ('active','archived')),created_at TEXT NOT NULL,\n  PRIMARY KEY(workspace_id,product_id,request_id),\n  FOREIGN KEY(workspace_id,product_id) REFERENCES products(workspace_id,id) ON DELETE CASCADE\n);",
        "params": []
      },
      {
        "sql": "CREATE TABLE product_write_guards (token TEXT PRIMARY KEY,workspace_id TEXT NOT NULL,product_id TEXT NOT NULL,ok INTEGER NOT NULL CHECK(ok=1));",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER product_guard_update BEFORE UPDATE ON products\nWHEN OLD.current_profile_version_id IS NOT NULL AND NOT EXISTS (\n  SELECT 1 FROM product_write_guards g WHERE g.workspace_id=OLD.workspace_id AND g.product_id=OLD.id AND g.ok=1\n) BEGIN SELECT RAISE(ABORT,'legacy_write_blocked'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER product_pointer_scope BEFORE UPDATE OF current_profile_version_id ON products\nWHEN NEW.current_profile_version_id IS NOT NULL AND NOT EXISTS (\n  SELECT 1 FROM product_profile_versions v WHERE v.id=NEW.current_profile_version_id AND v.workspace_id=NEW.workspace_id AND v.product_id=NEW.id\n) BEGIN SELECT RAISE(ABORT,'profile_pointer_scope'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER profile_immutable BEFORE UPDATE ON product_profile_versions BEGIN SELECT RAISE(ABORT,'profile_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER reference_immutable BEFORE UPDATE ON product_reference_versions\nWHEN NEW.id IS NOT OLD.id OR NEW.workspace_id IS NOT OLD.workspace_id OR NEW.product_id IS NOT OLD.product_id\n OR NEW.asset_id IS NOT OLD.asset_id OR NEW.version_number IS NOT OLD.version_number\n OR NEW.reference_role IS NOT OLD.reference_role OR NEW.created_at IS NOT OLD.created_at OR NEW.promoted_at IS NOT OLD.promoted_at\nBEGIN SELECT RAISE(ABORT,'reference_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER reference_guard_insert BEFORE INSERT ON product_reference_versions\nWHEN EXISTS(SELECT 1 FROM products p WHERE p.id=NEW.product_id AND p.current_profile_version_id IS NOT NULL)\n AND NOT EXISTS(SELECT 1 FROM product_write_guards g WHERE g.workspace_id=NEW.workspace_id AND g.product_id=NEW.product_id AND g.ok=1)\nBEGIN SELECT RAISE(ABORT,'legacy_write_blocked'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER reference_guard_status BEFORE UPDATE OF status ON product_reference_versions\nWHEN EXISTS(SELECT 1 FROM products p WHERE p.id=OLD.product_id AND p.current_profile_version_id IS NOT NULL)\n AND NOT EXISTS(SELECT 1 FROM product_write_guards g WHERE g.workspace_id=OLD.workspace_id AND g.product_id=OLD.product_id AND g.ok=1)\nBEGIN SELECT RAISE(ABORT,'legacy_write_blocked'); END;",
        "params": []
      },
      {
        "sql": "CREATE TABLE batch_product_snapshots (\n  batch_id TEXT PRIMARY KEY REFERENCES batches(id) ON DELETE CASCADE,\n  workspace_id TEXT NOT NULL REFERENCES workspaces(id) ON DELETE CASCADE,\n  product_id TEXT NOT NULL,product_revision INTEGER NOT NULL,profile_version_id TEXT NOT NULL,reference_version_id TEXT NOT NULL,\n  snapshot_json TEXT NOT NULL CHECK(json_valid(snapshot_json)),snapshot_sha256 TEXT NOT NULL CHECK(length(snapshot_sha256)=64),bound_at TEXT NOT NULL\n);",
        "params": []
      },
      {
        "sql": "CREATE TABLE analysis_product_snapshots (\n  analysis_id TEXT PRIMARY KEY REFERENCES analyses(id) ON DELETE CASCADE,\n  workspace_id TEXT NOT NULL REFERENCES workspaces(id) ON DELETE CASCADE,\n  product_id TEXT NOT NULL,product_revision INTEGER NOT NULL,profile_version_id TEXT NOT NULL,reference_version_id TEXT NOT NULL,\n  snapshot_json TEXT NOT NULL CHECK(json_valid(snapshot_json)),snapshot_sha256 TEXT NOT NULL CHECK(length(snapshot_sha256)=64),bound_at TEXT NOT NULL,\n  source_batch_id TEXT\n);",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER batch_snapshot_immutable BEFORE UPDATE ON batch_product_snapshots BEGIN SELECT RAISE(ABORT,'snapshot_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER analysis_snapshot_immutable BEFORE UPDATE ON analysis_product_snapshots BEGIN SELECT RAISE(ABORT,'snapshot_immutable'); END;",
        "params": []
      }
    ]
  },
  {
    "statements": [
      {
        "sql": "CREATE TABLE review_write_guards (\n token TEXT PRIMARY KEY, analysis_id TEXT NOT NULL, workspace_id TEXT NOT NULL,\n ok INTEGER NOT NULL CHECK(ok=1)\n);",
        "params": []
      },
      {
        "sql": "CREATE TABLE review_events (\n id TEXT PRIMARY KEY,\n analysis_id TEXT NOT NULL REFERENCES analyses(id) ON DELETE RESTRICT,\n workspace_id TEXT NOT NULL REFERENCES workspaces(id) ON DELETE RESTRICT,\n actor_id TEXT NOT NULL REFERENCES user(id) ON DELETE RESTRICT,\n request_id TEXT NOT NULL,\n fingerprint TEXT NOT NULL CHECK(length(fingerprint)=64),\n expected_revision INTEGER NOT NULL CHECK(expected_revision>=0),\n revision INTEGER NOT NULL CHECK(revision=expected_revision+1),\n previous_decision_id TEXT REFERENCES review_events(id) ON DELETE RESTRICT,\n action TEXT NOT NULL CHECK(action IN ('approve','reject','revoke')),\n category TEXT NOT NULL CHECK(category IN ('false_positive','false_negative','intentional_change','wrong_reference','insufficient_evidence','other')),\n reason TEXT NOT NULL CHECK(length(trim(reason)) BETWEEN 1 AND 1000),\n note TEXT CHECK(note IS NULL OR length(note)<=2000),\n machine_snapshot_json TEXT NOT NULL CHECK(json_valid(machine_snapshot_json)),\n machine_sha256 TEXT NOT NULL CHECK(length(machine_sha256)=64),\n created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),\n UNIQUE(analysis_id,revision), UNIQUE(analysis_id,request_id)\n);",
        "params": []
      },
      {
        "sql": "CREATE INDEX review_events_owner ON review_events(workspace_id,analysis_id,revision);",
        "params": []
      },
      {
        "sql": "CREATE TABLE review_heads (\n analysis_id TEXT PRIMARY KEY REFERENCES analyses(id) ON DELETE RESTRICT,\n workspace_id TEXT NOT NULL REFERENCES workspaces(id) ON DELETE RESTRICT,\n revision INTEGER NOT NULL CHECK(revision>0),\n latest_event_id TEXT NOT NULL REFERENCES review_events(id) ON DELETE RESTRICT\n);",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER review_event_update_blocked BEFORE UPDATE ON review_events BEGIN SELECT RAISE(ABORT,'review_audit_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER review_event_delete_blocked BEFORE DELETE ON review_events BEGIN SELECT RAISE(ABORT,'review_audit_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER review_head_delete_blocked BEFORE DELETE ON review_heads BEGIN SELECT RAISE(ABORT,'review_head_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER review_event_append_guard BEFORE INSERT ON review_events\nWHEN NOT EXISTS(SELECT 1 FROM review_write_guards g WHERE g.analysis_id=NEW.analysis_id AND g.workspace_id=NEW.workspace_id)\n OR EXISTS(SELECT 1 FROM review_events e WHERE e.id=NEW.id OR (e.analysis_id=NEW.analysis_id AND e.request_id=NEW.request_id))\n OR NOT EXISTS(SELECT 1 FROM analyses a JOIN workspaces w ON w.id=a.workspace_id JOIN workspace_memberships m ON m.workspace_id=w.id\n WHERE a.id=NEW.analysis_id AND a.workspace_id=NEW.workspace_id AND a.status='completed' AND w.status='active' AND m.user_id=NEW.actor_id AND m.role='owner'\n AND json_extract(NEW.machine_snapshot_json,'$.verdict') IS a.verdict\n AND json_extract(NEW.machine_snapshot_json,'$.qaEngineVersion') IS a.qa_engine_version\n AND json_extract(NEW.machine_snapshot_json,'$.riskPolicyVersion') IS a.risk_policy_version\n AND json_extract(NEW.machine_snapshot_json,'$.modelPolicyVersion') IS a.model_policy_version)\n OR NEW.expected_revision<>COALESCE((SELECT revision FROM review_heads WHERE analysis_id=NEW.analysis_id AND workspace_id=NEW.workspace_id),0)\n OR NEW.previous_decision_id IS NOT (SELECT latest_event_id FROM review_heads WHERE analysis_id=NEW.analysis_id AND workspace_id=NEW.workspace_id)\n OR (NEW.action='revoke' AND NOT EXISTS(SELECT 1 FROM review_heads h JOIN review_events e ON e.id=h.latest_event_id WHERE h.analysis_id=NEW.analysis_id AND e.action IN ('approve','reject')))\nBEGIN SELECT RAISE(ABORT,'review_append_guard'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER review_head_insert_guard BEFORE INSERT ON review_heads\nWHEN EXISTS(SELECT 1 FROM review_heads WHERE analysis_id=NEW.analysis_id) OR NEW.revision<>1 OR NOT EXISTS(SELECT 1 FROM review_events e JOIN review_write_guards g ON g.analysis_id=e.analysis_id AND g.workspace_id=e.workspace_id\n WHERE e.id=NEW.latest_event_id AND e.analysis_id=NEW.analysis_id AND e.workspace_id=NEW.workspace_id AND e.revision=NEW.revision AND e.previous_decision_id IS NULL)\nBEGIN SELECT RAISE(ABORT,'review_head_guard'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER review_head_update_guard BEFORE UPDATE ON review_heads\nWHEN NEW.analysis_id<>OLD.analysis_id OR NEW.workspace_id<>OLD.workspace_id OR NEW.revision<>OLD.revision+1\n OR NOT EXISTS(SELECT 1 FROM review_events e JOIN review_write_guards g ON g.analysis_id=e.analysis_id AND g.workspace_id=e.workspace_id\n WHERE e.id=NEW.latest_event_id AND e.analysis_id=NEW.analysis_id AND e.workspace_id=NEW.workspace_id AND e.revision=NEW.revision AND e.previous_decision_id=OLD.latest_event_id)\nBEGIN SELECT RAISE(ABORT,'review_head_guard'); END;",
        "params": []
      }
    ]
  },
  {
    "statements": [
      {
        "sql": "CREATE TABLE analysis_value_classifications (\n id TEXT PRIMARY KEY,\n analysis_id TEXT NOT NULL REFERENCES analyses(id) ON DELETE RESTRICT,\n workspace_id TEXT NOT NULL REFERENCES workspaces(id) ON DELETE RESTRICT,\n revision INTEGER NOT NULL CHECK(revision>0),\n classification TEXT NOT NULL CHECK(classification IN ('business','test','unknown')),\n evidence_ref TEXT NOT NULL CHECK(length(evidence_ref)=73 AND substr(evidence_ref,1,9)='evidence:' AND substr(evidence_ref,10) NOT GLOB '*[^a-f0-9]*'),\n verified_by TEXT NOT NULL CHECK(length(verified_by) BETWEEN 1 AND 128 AND verified_by NOT GLOB '*[^a-zA-Z0-9_-]*'),\n verified_at TEXT NOT NULL CHECK(strftime('%Y-%m-%dT%H:%M:%fZ',verified_at) IS verified_at),\n material_sha256 TEXT NOT NULL CHECK(length(material_sha256)=64 AND material_sha256 NOT GLOB '*[^a-f0-9]*'),\n created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),\n UNIQUE(analysis_id,revision)\n);",
        "params": []
      },
      {
        "sql": "CREATE INDEX value_classifications_scope ON analysis_value_classifications(workspace_id,analysis_id,revision DESC);",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER value_classification_append_guard BEFORE INSERT ON analysis_value_classifications\nWHEN EXISTS(SELECT 1 FROM analysis_value_classifications WHERE id=NEW.id OR (analysis_id=NEW.analysis_id AND revision=NEW.revision))\n OR NOT EXISTS(SELECT 1 FROM analyses WHERE id=NEW.analysis_id AND workspace_id=NEW.workspace_id)\n OR NEW.revision<>COALESCE((SELECT MAX(revision) FROM analysis_value_classifications WHERE analysis_id=NEW.analysis_id),0)+1\n OR julianday(NEW.verified_at)>julianday('now') OR strftime('%Y-%m-%dT%H:%M:%fZ',NEW.created_at) IS NOT NEW.created_at\n OR julianday(NEW.created_at)>julianday('now')\nBEGIN SELECT RAISE(ABORT,'value_classification_scope_or_revision'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER value_classification_update_blocked BEFORE UPDATE ON analysis_value_classifications BEGIN SELECT RAISE(ABORT,'value_classification_immutable'); END;",
        "params": []
      },
      {
        "sql": "CREATE TRIGGER value_classification_delete_blocked BEFORE DELETE ON analysis_value_classifications BEGIN SELECT RAISE(ABORT,'value_classification_immutable'); END;",
        "params": []
      }
    ]
  },
